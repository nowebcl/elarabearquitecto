rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Textos dinámicos de la landing page (Firestore Real-time CMS)
    match /site_content/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Galería de imágenes del portafolio
    match /gallery/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mensajes y consultas recibidas
    match /consultas/{document} {
      allow read, write: if true; // Write true so public can send contact forms!
    }
  }
}
