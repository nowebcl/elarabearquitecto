rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Textos dinámicos de la landing page (Firestore Real-time CMS)
    match /site_content/{document} {
      allow read, write: if true;
    }

    // Galería de imágenes del portafolio
    match /gallery/{document} {
      allow read, write: if true;
    }

    // Mensajes y consultas recibidas
    match /consultas/{document} {
      allow read, write: if true;
    }
  }
}
